  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python3",
            "args": [
              "-I",
              "{{DOTFILES}}/settings/hooks/allow_repo_push.py",
              "--repo",
              "/local/home/pablomv/obsidian-vaults/vault",
              "--url",
              "{{VAULT_PUSH_URL}}",
              "--remote",
              "origin",
              "--branch",
              "mainline"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "auto-mode-setup": "off"
  },
  "autoMode": {
    "classifyAllShell": true,
    "environment": [
      "$defaults",
      "Organization: Amazon, EU S&OP (supply chain sales and operations planning). Primary use: data engineering, reporting automation and analysis, plus some personal side projects under ~/projects.",
      "Source control: git.amazon.com and code.amazon.com (CRUX code reviews) for Amazon packages; github.com/SearchingAlpha (private repos) for personal tooling such as claude-dotfiles. Amazon-internal content never goes to github.com.",
      "Cloud provider(s): AWS. Amazon Bedrock in account {{AWS_ACCOUNT_ID}} (us-east-1) is the only sanctioned LLM endpoint for Amazon data.",
      "Host containment: an Amazon cloud desktop (Amazon Linux 2023). AWS identity comes from AWS_PROFILE=ceu-execution via ada; Midway cookies live in ~/.midway.",
      "Trusted internal domains: *.amazon.com, *.a2z.com, *.aws.dev, and {{SHAREPOINT_SITE}} (the EU S&OP team site).",
      "Key internal services: Datanet (datanet-service REST API) for ETL jobs; Redshift/Reservoir schema {{REDSHIFT_SCHEMA}}; Outlook and SharePoint through their MCP servers.",
      "Internal package registry: npm installs go through the CodeArtifact registry set in ~/.npmrc (*.d.codeartifact.us-west-2.amazonaws.com).",
      "Sensitive data locations & audiences: Amazon-confidential data in Redshift and Datanet query results, in ~/workplace/, and in the Obsidian vault folder 10-work/; audience is Amazon-internal only."
    ],
    "soft_deny": [
      "$defaults",
      "Datanet ETL writes: creating or updating a Datanet ETL job with DRY_RUN off, unless the user named that job in this session or it is listed in the SCA serving-layer registry (projects/scratch/sca-serving-layer).",
      "Email outside the approval prompt: sending email by any route other than the Outlook MCP tools (for example SES, Microsoft Graph, SMTP via curl or python) unless the user named the recipient."
    ],
    "hard_deny": [
      "$defaults",
      "Amazon data off-network: sending Amazon-internal content (anything from ~/workplace/, the vault folder 10-work/, or Redshift/Datanet query results) to any non-Amazon destination, including github.com, paste sites and third-party LLM or search APIs."
    ]
  }
