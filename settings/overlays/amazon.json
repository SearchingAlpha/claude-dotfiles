{
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "us-east-1",
    "AWS_PROFILE": "ceu-execution",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "us.anthropic.claude-opus-5-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "us.anthropic.claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "us.anthropic.claude-haiku-5-5",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "us.anthropic.claude-fable-5-1",
    "STATUSLINE_TZ": "Europe/Luxembourg"
  },
  "awsAuthRefresh": "ada credentials update --profile ceu-execution",
  "timeZone": "Europe/Luxembourg",
  "disableDeepLinkRegistration": "disable",
  "footerLinksRegexes": [
    {
      "type": "regex",
      "pattern": "\\b(?<cr>CR-\\d{8,10})\\b",
      "url": "{{CODE_REVIEW_URL}}{cr}",
      "label": "{cr}"
    },
    {
      "type": "regex",
      "pattern": "\\b(?<tt>[DPV]\\d{9,10})\\b",
      "url": "{{TICKET_URL}}{tt}",
      "label": "{tt}"
    }
  ],
  "extraKnownMarketplaces": {
    "aim": {
      "source": {
        "source": "directory",
        "path": "/local/home/pablomv/.aim/cc-plugins"
      }
    },
    "cosmo-adherence-agent": {
      "source": {
        "source": "directory",
        "path": "/home/pablomv/workplace/CosmoAdherenceAgent"
      }
    }
  },
  "enabledPlugins": {
    "AmazonBuilderCoreAIAgents-core@aim": true,
    "cosmo-sop-skills@cosmo-adherence-agent": true
  }
}
