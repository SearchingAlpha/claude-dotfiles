# Copia este archivo a .env y rellena tus claves.  NUNCA subas .env a git.
#   cp .env.example .env

# --- Claude / LLM ------------------------------------------------------------
# Proveedor: anthropic (por defecto) | aws | bedrock
LLM_PROVIDER=anthropic

# Opción A (por defecto): API oficial de Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Modelo y límite de tokens (opcionales; hay defaults en config.py)
# CLAUDE_MODEL=claude-opus-5        # usa claude-sonnet-5 para iterar más rápido/barato
# CLAUDE_MAX_TOKENS=4096

# Opción B: Claude Platform on AWS  (LLM_PROVIDER=aws)
# AWS_REGION=us-east-1
# ANTHROPIC_AWS_WORKSPACE_ID=...

# Opción C: Amazon Bedrock  (LLM_PROVIDER=bedrock)  -> credenciales AWS estándar
# AWS_REGION=us-east-1

# --- Exa (búsqueda) ----------------------------------------------------------
EXA_API_KEY=...

# --- fal.ai (imágenes) -------------------------------------------------------
FAL_KEY=...
# FAL_IMAGE_MODEL=fal-ai/flux/schnell
