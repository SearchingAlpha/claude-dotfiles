{
  "about": "SupplyChainAgents: the ontology build its scripts/ontology pipeline writes (ontology/build), and the deploy scripts of its Slack repo. sca.md is the how-to.",
  "private": ["owner"],
  "options": {
    "store": "ontology/build",
    "storeFlag": "",
    "storeLabel": "ontology",
    "cmdRegex": "(?:^|[\\n;&|(])[ \\t]*(?:(?:do|then|else|if|elif|while|until|\\{|!)[ \\t]+)*(?:(?:timeout|time|env|nohup|exec|command|nice|sudo|xargs)(?:[ \\t]+-[^\\s;&|()]+(?:[ \\t]+[^-\\s;&|()][^\\s;&|()]*)?)*(?:[ \\t]+\\d[\\w.]*)?[ \\t]+|[A-Za-z_]\\w*=[^\\s;&|()]*[ \\t]+|(?:ba|z)?sh[ \\t]+-[a-z]*c[ \\t]+['\"])*(?:(?:[^\\s;&|()]*/)?python3?(?:\\.\\d+)?[ \\t]+(?:-[XW][ \\t]*[^\\s;&|()]+[ \\t]+|-\\w+[ \\t]+)*)?(?:[^\\s;&|()]*/)?(?:scripts/ontology/((?:extract|validate|compile|probe|onto|questions)\\.py)|deploy/(ontology(?:_load)?\\.py(?:[ \\t]+[a-z][\\w-]*){0,2}))",
    "mcpPrefix": "",
    "manifestFile": "manifest.json",
    "nodesFile": "nodes.jsonl",
    "edgesFile": "edges.jsonl",
    "opsFile": "",
    "versionKey": "ov",
    "nodeKeys": "id label props",
    "edgeKeys": "from type to",
    "nameKeys": "name",
    "statusKey": "status",
    "sourceKey": "source",
    "conflictsKey": "open_conflicts",
    "queueStatus": "proposed",
    "acceptStatus": "curated",
    "owner": "",
    "patchDir": "",
    "band": true,
    "toast": true
  },
  "samples": {
    "ops": [
      ["python3 scripts/ontology/compile.py", "compile.py"],
      ["cd /repo && python3 scripts/ontology/extract.py --all", "extract.py"],
      ["python3 scripts/ontology/validate.py && python3 scripts/ontology/compile.py", "validate.py"],
      ["python3 scripts/ontology/validate.py --strict   # warnings fail too", "validate.py"],
      ["python3 scripts/ontology/questions.py --file ontology/questions/dev.yaml", "questions.py"],
      ["python3 scripts/ontology/probe.py --week 2026-38", "probe.py"],
      [".venv/bin/python3 scripts/ontology/onto.py show x", "onto.py"],
      ["PYTHONPATH=. python3 -u scripts/ontology/compile.py", "compile.py"],
      ["./scripts/ontology/compile.py", "compile.py"],
      ["scripts/ontology/compile.py", "compile.py"],
      ["python3 deploy/ontology.py beta query --gremlin \"g.V().count()\"", "ontology.py beta query"],
      ["python3 deploy/ontology.py beta status", "ontology.py beta status"],
      ["python3 deploy/ontology_load.py beta", "ontology_load.py beta"],
      ["(cd ../x && ./deploy/ontology_load.py run now)", "ontology_load.py run now"],
      ["for f in a b; do python3 scripts/ontology/compile.py; done", "compile.py"],
      ["cd ~/repo && python3 scripts/ontology/compile.py", "compile.py"],
      ["python3 scripts/ontology/compile.py --check", "compile.py"],
      ["pytest scripts/ontology/tests; python3 scripts/ontology/validate.py", "validate.py"],
      ["timeout 600 python3 -X dev scripts/ontology/compile.py", "compile.py"],
      ["  python3 scripts/ontology/compile.py", "compile.py"]
    ],
    "notOps": [
      "cat scripts/ontology/compile.py",
      "sed -n 1,80p scripts/ontology/extract.py",
      "grep -n \"def main\" scripts/ontology/validate.py",
      "git diff scripts/ontology/compile.py",
      "git diff -- scripts/ontology/compile.py",
      "git add scripts/ontology/onto.py",
      "git log --oneline -- deploy/ontology.py",
      "wc -l scripts/ontology/questions.py",
      "python3 -m py_compile scripts/ontology/compile.py",
      "python3 -m pytest scripts/ontology/tests",
      "pytest scripts/ontology/tests",
      "cat ontology/build/manifest.json",
      "head -50 deploy/ontology_load.py",
      "vim scripts/ontology/compile.py",
      "black scripts/ontology/compile.py",
      "ruff check scripts/ontology/compile.py",
      "cp scripts/ontology/compile.py /tmp/x.py",
      "chmod +x scripts/ontology/compile.py",
      "mypy scripts/ontology/onto.py",
      "git checkout -- scripts/ontology/onto.py",
      "git mv scripts/ontology/onto.py scripts/ontology/onto2.py",
      "touch scripts/ontology/compile.py"
    ]
  }
}
